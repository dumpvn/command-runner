{
    "name": "command-runner",
    "displayName": "command runner",
    "description": "command runner",
    "version": "0.0.133",
    "icon": "resource/powershell_128px.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/dumpvn/command-runner.git"
    },
    "homepage": "https://github.com/dumpvn/command-runner/blob/master/README.md",
    "bugs": {
        "url": "https://github.com/dumpvn/command-runner/issues",
        "email": "dumpvn@gmail.com"
    },
    "publisher": "dumpvn",
    "engines": {
        "vscode": "^1.68.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:command-runner.run",
        "onCommand:command-runner.runInTerminal",
        "onCommand:command-runner.runChatCopilot",
        "onCommand:command-runner.renameTerminalToActiveFile",
        "onCommand:command-runner.readAloud",
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "command-runner.run",
                "title": "Run Command"
            },
            {
                "command": "command-runner.runInTerminal",
                "title": "Run In Terminal"
            },
            {
                "command": "command-runner.renameTerminalToActiveFile",
                "title": "Rename Terminal to Active File Basename"
            },
            {
                "command": "command-runner.readAloud",
                "title": "Read Aloud"
            },
            {
                "command": "command-runner.task.setBlocked",
                "title": "Set Blocked",
                "icon": "$(error)"
            },
            {
                "command": "command-runner.task.setInProgress",
                "title": "Set In Progress",
                "icon": "$(play)"
            },
            {
                "command": "command-runner.task.setWaiting",
                "title": "Set Waiting/Review",
                "icon": "$(watch)"
            },
            {
                "command": "command-runner.task.setTodo",
                "title": "Set Todo",
                "icon": "$(circle-outline)"
            },
            {
                "command": "command-runner.task.setDone",
                "title": "Set Done",
                "icon": "$(pass-filled)"
            },
            {
                "command": "command-runner.task.clear",
                "title": "Clear Status"
            },
            {
                "command": "command-runner.task.reopen",
                "title": "Reopen Terminal",
                "icon": "$(terminal)"
            },
            {
                "command": "command-runner.task.remove",
                "title": "Remove Task",
                "icon": "$(trash)"
            },
            {
                "command": "command-runner.task.focus",
                "title": "Focus Terminal"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Command Runner",
            "properties": {
                "command-runner.llm.default": {
                    "type": "string",
                    "default": "",
                    "description": "default LLM to be used for prompt",
                    "scope": "resource"
                },
                "command-runner.terminal.name": {
                    "type": "string",
                    "default": "",
                    "description": "Specifies the terminal name to execute the command.",
                    "scope": "resource"
                },
                "command-runner.terminal.cwd": {
                    "type": "string",
                    "description": "A path or Uri for the current working directory to be used for the terminal.",
                    "scope": "resource"
                },
                "command-runner.terminal.env": {
                    "type": "string",
                    "description": "Object with environment variables that will be added to the VS Code process.",
                    "scope": "resource"
                },
                "command-runner.terminal.shellPath": {
                    "type": "string",
                    "description": "A path to a custom shell executable to be used in the terminal.",
                    "scope": "resource"
                },
                "command-runner.terminal.shellArgs": {
                    "type": [
                        "string",
                        "array"
                    ],
                    "description": "Args for the custom shell executable. A string can be used on Windows only which allows specifying shell args in command-line format.",
                    "scope": "resource"
                },
                "command-runner.terminal.executeLineByLine": {
                    "type": "boolean",
                    "default": false,
                    "description": "Split the selected content into multiple lines and execute line by line",
                    "scope": "resource"
                },
                "command-runner.terminal.replaceTemplate": {
                    "type": "boolean",
                    "default": false,
                    "description": "Replace placeholder template",
                    "scope": "resource"
                },
                "command-runner.terminal.commandDelay": {
                    "type": "number",
                    "default": 50,
                    "description": "Delay milliseconds between commands",
                    "scope": "resource"
                },
                "command-runner.terminal.autoClear": {
                    "type": "boolean",
                    "default": true,
                    "description": "Clear the content of terminal before execute the command.",
                    "scope": "resource"
                },
                "command-runner.terminal.autoFocus": {
                    "type": "boolean",
                    "default": true,
                    "description": "Focus the terminal when execute the command.",
                    "scope": "resource"
                },
                "command-runner.terminal.autoScrollToBottom": {
                    "type": "boolean",
                    "default": true,
                    "description": "Auto scroll terminal to bottom after executing command.",
                    "scope": "resource"
                },
                "command-runner.terminal.sendRawText": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable this option to send raw text without preprocessing",
                    "scope": "resource"
                },
                "command-runner.commands": {
                    "type": "object",
                    "default": {
                        "chatgpt": "chatgpt"
                    },
                    "description": "Set the custom command to run.",
                    "scope": "resource"
                },
                "command-runner.showRunCommandInEditorContextMenu": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show 'Run Command' in editor context menu",
                    "scope": "resource"
                },
                "command-runner.showRunCommandInExplorerContextMenu": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show 'Run Command' in explorer context menu",
                    "scope": "resource"
                },
                "command-runner.readAloud.voice": {
                    "type": "string",
                    "default": "",
                    "description": "Installed SAPI voice name for Read Aloud (empty = system default). e.g. 'Microsoft Zira Desktop'.",
                    "scope": "resource"
                },
                "command-runner.readAloud.rate": {
                    "type": "number",
                    "default": 0,
                    "minimum": -10,
                    "maximum": 10,
                    "description": "Read Aloud speaking rate (System.Speech scale, -10 to 10).",
                    "scope": "resource"
                }
            }
        },
        "keybindings": [
            {
                "command": "command-runner.run",
                "key": "ctrl+shift+r",
                "mac": "ctrl+shift+r"
            },
            {
                "command": "command-runner.runInTerminal",
                "key": "ctrl+shift+enter",
                "mac": "ctrl+shift+enter",
                "when": "editorTextFocus"
            },
            {
                "command": "command-runner.runChatCopilot",
                "key": "ctrl+alt+enter",
                "when": "editorTextFocus"
            },
            {
                "command": "command-runner.readAloud",
                "key": "ctrl+alt+r",
                "when": "editorTextFocus"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "!inOutput && config.command-runner.showRunCommandInEditorContextMenu",
                    "command": "command-runner.run",
                    "group": "navigation"
                },
                {
                    "when": "editorHasSelection && !inOutput && config.command-runner.showRunCommandInEditorContextMenu",
                    "command": "command-runner.runInTerminal",
                    "group": "navigation"
                },
                {
                    "when": "editorHasSelection && !inOutput",
                    "command": "command-runner.readAloud",
                    "group": "navigation"
                }
            ],
            "explorer/context": [
                {
                    "when": "config.command-runner.showRunCommandInExplorerContextMenu",
                    "command": "command-runner.run",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "command-runner.task.setInProgress",
                    "when": "view == command-runner.tasks && viewItem == task-open",
                    "group": "inline@1"
                },
                {
                    "command": "command-runner.task.setBlocked",
                    "when": "view == command-runner.tasks && viewItem == task-open",
                    "group": "inline@2"
                },
                {
                    "command": "command-runner.task.setDone",
                    "when": "view == command-runner.tasks && viewItem == task-open",
                    "group": "inline@3"
                },
                {
                    "command": "command-runner.task.setBlocked",
                    "when": "view == command-runner.tasks",
                    "group": "1_status@1"
                },
                {
                    "command": "command-runner.task.setInProgress",
                    "when": "view == command-runner.tasks",
                    "group": "1_status@2"
                },
                {
                    "command": "command-runner.task.setWaiting",
                    "when": "view == command-runner.tasks",
                    "group": "1_status@3"
                },
                {
                    "command": "command-runner.task.setTodo",
                    "when": "view == command-runner.tasks",
                    "group": "1_status@4"
                },
                {
                    "command": "command-runner.task.setDone",
                    "when": "view == command-runner.tasks",
                    "group": "1_status@5"
                },
                {
                    "command": "command-runner.task.clear",
                    "when": "view == command-runner.tasks",
                    "group": "2_manage@1"
                },
                {
                    "command": "command-runner.task.reopen",
                    "when": "view == command-runner.tasks && viewItem == task-closed",
                    "group": "inline@1"
                },
                {
                    "command": "command-runner.task.remove",
                    "when": "view == command-runner.tasks && viewItem == task-closed",
                    "group": "2_manage@2"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "command-runner",
                    "title": "Command Runner",
                    "icon": "resource/tasks.svg"
                }
            ]
        },
        "views": {
            "command-runner": [
                {
                    "id": "command-runner.tasks",
                    "name": "Tasks"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "command-runner.tasks",
                "contents": "No tasks yet.\nEach terminal appears here as a task.\nRight-click a task to set its status (Blocked, In Progress, Waiting, Todo, Done)."
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^7.1.4",
        "@types/mocha": "^9.0.0",
        "@types/node": "14.x",
        "@types/vscode": "^1.68.0",
        "@typescript-eslint/eslint-plugin": "^4.31.1",
        "@typescript-eslint/parser": "^4.31.1",
        "@vscode/test-electron": "^1.6.2",
        "eslint": "^7.32.0",
        "glob": "^7.1.7",
        "mocha": "^11.3.0",
        "typescript": "^4.4.3"
    }
}
